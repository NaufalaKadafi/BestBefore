# --- Bifrost (LLM gateway). Every model call in this project goes through it. ---
BIFROST_URL=http://localhost:8080
# Virtual key created in the Bifrost UI (Governance -> Virtual Keys). Give it a small budget.
BIFROST_VIRTUAL_KEY=sk-bf-your-virtual-key

# Model IDs in Bifrost "provider/model" form.
# We ship NO default model IDs on purpose: hard-coded model names go stale,
# which is exactly the problem this project detects. Use models your Bifrost can reach today.
MODEL_EXTRACT=provider/cheap-fast-model
MODEL_JUDGE=provider/stronger-model
# Optional: a judge from a DIFFERENT provider. Every verdict is then checked by both models,
# and a claim only gets a label when they agree. Doubles judge cost.
MODEL_JUDGE_2=
# Comma-separated fallbacks tried by Bifrost when the primary fails (optional but recommended).
MODEL_FALLBACKS=other-provider/another-model
# Model used when a proxied chat request does not name one (optional).
MODEL_CHAT=

# --- Tavily (live web evidence) ---
TAVILY_API_KEY=tvly-your-key

# --- App ---
PORT=8787
MAX_CLAIMS=8
WORKERS=4
# Pin "today" for reproducible tests/demos (YYYY-MM-DD). Leave empty in normal use.
BESTBEFORE_TODAY=
